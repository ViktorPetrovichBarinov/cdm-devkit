{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension",
        "streetsidesoftware.code-spell-checker"
      ],
      "outFiles": ["${workspaceFolder}/client/out/**/*.js"]
    },
    {
      "name": "Build & Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extension",
        "streetsidesoftware.code-spell-checker"
      ],
      "preLaunchTask": "Compile CDM Extension",
      "outFiles": ["${workspaceFolder}/client/out/**/*.js"]
    }
  ]
}