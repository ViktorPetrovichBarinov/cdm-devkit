{
    "name": "cdm16-lsp",
    "displayName": "CDM16 LSP",
    "description": "lsp extension for cdm-16 assembly",
    "author": "Ruslan Chudinov",
    "repository": {
        "type": "git",
        "url": "https://example.com/TODO.git"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "version": "0.0.1",
    "extensionDependencies": [
        "ms-python.python"
    ],
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "configurationDefaults": {
            "editor.semanticHighlighting.enabled": true
        },
        "configuration": {
            "title": "CDM",
            "properties": {
                "cdm.dialect": {
                    "type": "string",
                    "default": "cdm16",
                    "enum": ["cdm8", "cdm8e", "cdm16", "cdm16e"],
                    "enumDescriptions": [
                        "CDM8 dialect",
                        "CDM8E dialect", 
                        "CDM16 dialect",
                        "CDM16E dialect"
                    ],
                    "description": "Select the CDM dialect to use for language server features."
                },
                "cdm.pythonPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional: explicit path to the Python executable used to run the CDM language server. If empty, the extension will use the active interpreter selected by the Python extension."
                },
                "cdm.autoInstall": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically create a private virtual environment for the extension and install Python dependencies on first run (and when requirements change)."
                }
            }
        }
    },
    "activationEvents": [
        "workspaceContains:**/*.asm",
        "workspaceContains:**/*.mlb"
    ],
    
    
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p .",
        "watch": "tsc -p . -w"
    },
    "devDependencies": {
        "@types/node": "^20",
        "@types/semver": "^7.5.0",
        "@types/vscode": "^1.78.0",
        "@typescript-eslint/eslint-plugin": "^5.3.0",
        "@typescript-eslint/parser": "^5.3.0",
        "eslint": "^8.2.0",
        "typescript": "^5.1.0"
    },
    "dependencies": {
        "@vscode/python-extension": "^1.0.4",
        "semver": "^7.5.4",
        "vscode-languageclient": "^8.1.0"
    }
}